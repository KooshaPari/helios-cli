# Helios CLI — Production OTel Stack Environment Variables
# Copy this file to .env and fill in values before deploying.
#
# Usage:
#   cp .env.production .env
#   # Edit .env with production values
#   ./deploy.sh --env .env

# ──────────────────────────────────────────────────────────
# Image versions (pinned for reproducibility)
# ──────────────────────────────────────────────────────────
OTEL_COLLECTOR_VERSION=0.108.0
JAEGER_VERSION=1.61
PROMETHEUS_VERSION=v2.54.1
GRAFANA_VERSION=11.2.2

# ──────────────────────────────────────────────────────────
# Service versions
# ──────────────────────────────────────────────────────────
OTEL_SERVICE_VERSION=0.2.1

# ──────────────────────────────────────────────────────────
# Jaeger / Tracing backend
# ──────────────────────────────────────────────────────────
JAEGER_OTLP_ENDPOINT=jaeger:4317

# ──────────────────────────────────────────────────────────
# Collector resource limits
# ──────────────────────────────────────────────────────────
COLLECTOR_MEM_LIMIT=1g
COLLECTOR_MEM_RESERVATION=512m
COLLECTOR_CPU_LIMIT=2.0
COLLECTOR_CPU_RESERVATION=0.5

# ──────────────────────────────────────────────────────────
# Prometheus retention
# ──────────────────────────────────────────────────────────
PROMETHEUS_RETENTION_DAYS=30
PROMETHEUS_STORAGE_RETENTION_SIZE=10GB

# ──────────────────────────────────────────────────────────
# Grafana credentials (CHANGE THESE)
# ──────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# ──────────────────────────────────────────────────────────
# Network configuration
# ──────────────────────────────────────────────────────────
HELIOS_OTEL_NETWORK=helios-otel
HELIOS_OTEL_SUBNET=172.28.0.0/16
