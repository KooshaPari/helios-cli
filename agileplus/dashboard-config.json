{
  "$schema": "https://json.schemastore.org/dashboard-config.json",
  "dashboard": {
    "title": "HeliosCLI Operations Dashboard",
    "description": "Real-time observability for latency, throughput, errors, and saturation across all regions.",
    "version": "1.0.0",
    "timezone": "UTC",
    "refresh_interval_seconds": 30,
    "theme": "dark"
  },
  "data_sources": [
    {
      "id": "otlp-metrics",
      "type": "opentelemetry",
      "name": "OTLP Metrics",
      "config": {
        "protocol": "grpc",
        "endpoint": "${OTEL_EXPORTER_OTLP_ENDPOINT:http://localhost:4317}",
        "timeout_ms": 5000,
        "retry": {
          "max_attempts": 3,
          "backoff_ms": 1000
        }
      }
    },
    {
      "id": "otlp-traces",
      "type": "opentelemetry",
      "name": "OTLP Traces",
      "config": {
        "protocol": "grpc",
        "endpoint": "${OTEL_EXPORTER_OTLP_ENDPOINT:http://localhost:4317}",
        "timeout_ms": 5000
      }
    },
    {
      "id": "prometheus",
      "type": "prometheus",
      "name": "Prometheus",
      "config": {
        "url": "${PROMETHEUS_URL:http://localhost:9090}",
        "scrape_interval_seconds": 15
      }
    },
    {
      "id": "jaeger",
      "type": "jaeger",
      "name": "Jaeger Traces",
      "config": {
        "url": "${JAEGER_URL:http://localhost:16686}"
      }
    }
  ],
  "panels": [
    {
      "id": "latency-p50",
      "title": "Request Latency (P50)",
      "type": "timeseries",
      "grid_position": { "col": 1, "row": 1, "col_span": 6, "row_span": 4 },
      "data_source": "otlp-metrics",
      "query": {
        "metric": "harness_recorder.span.duration_ms",
        "aggregation": "histogram_quantile",
        "quantile": 0.5,
        "group_by": ["service.name", "region"],
        "interval_seconds": 60
      },
      "thresholds": [
        { "value": 100, "color": "green", "label": "OK" },
        { "value": 500, "color": "yellow", "label": "Warning" },
        { "value": 2000, "color": "red", "label": "Critical" }
      ],
      "unit": "ms",
      "decimals": 1
    },
    {
      "id": "latency-p95",
      "title": "Request Latency (P95)",
      "type": "timeseries",
      "grid_position": { "col": 7, "row": 1, "col_span": 6, "row_span": 4 },
      "data_source": "otlp-metrics",
      "query": {
        "metric": "harness_recorder.span.duration_ms",
        "aggregation": "histogram_quantile",
        "quantile": 0.95,
        "group_by": ["service.name", "region"],
        "interval_seconds": 60
      },
      "thresholds": [
        { "value": 250, "color": "green", "label": "OK" },
        { "value": 1000, "color": "yellow", "label": "Warning" },
        { "value": 5000, "color": "red", "label": "Critical" }
      ],
      "unit": "ms",
      "decimals": 1
    },
    {
      "id": "throughput",
      "title": "Throughput (Requests/sec)",
      "type": "timeseries",
      "grid_position": { "col": 1, "row": 5, "col_span": 6, "row_span": 4 },
      "data_source": "otlp-metrics",
      "query": {
        "metric": "harness_recorder.spans.total",
        "aggregation": "rate",
        "group_by": ["service.name", "region"],
        "interval_seconds": 60
      },
      "thresholds": [
        { "value": 10, "color": "green", "label": "Normal" },
        { "value": 100, "color": "yellow", "label": "High" },
        { "value": 500, "color": "red", "label": "Saturated" }
      ],
      "unit": "reqps",
      "decimals": 0
    },
    {
      "id": "error-rate",
      "title": "Error Rate",
      "type": "timeseries",
      "grid_position": { "col": 7, "row": 5, "col_span": 6, "row_span": 4 },
      "data_source": "otlp-metrics",
      "query": {
        "metric": "harness_recorder.script.failures",
        "aggregation": "rate",
        "group_by": ["service.name", "region"],
        "interval_seconds": 60
      },
      "thresholds": [
        { "value": 0.1, "color": "green", "label": "Healthy" },
        { "value": 1.0, "color": "yellow", "label": "Warning" },
        { "value": 5.0, "color": "red", "label": "Critical" }
      ],
      "unit": "percent",
      "decimals": 2
    },
    {
      "id": "active-terminals",
      "title": "Active Terminals (Saturation)",
      "type": "gauge",
      "grid_position": { "col": 1, "row": 9, "col_span": 6, "row_span": 4 },
      "data_source": "otlp-metrics",
      "query": {
        "metric": "harness_recorder.terminals.active",
        "aggregation": "latest",
        "group_by": ["region"]
      },
      "thresholds": [
        { "value": 0, "color": "green", "label": "Idle" },
        { "value": 50, "color": "yellow", "label": "Moderate" },
        { "value": 100, "color": "red", "label": "Saturated" }
      ],
      "min": 0,
      "max": 200,
      "unit": "count"
    },
    {
      "id": "circuit-breaker-state",
      "title": "Circuit Breaker State",
      "type": "state-timeline",
      "grid_position": { "col": 7, "row": 9, "col_span": 6, "row_span": 4 },
      "data_source": "otlp-metrics",
      "query": {
        "metric": "harness_recorder.circuit_breaker.state",
        "aggregation": "latest",
        "group_by": ["service.name"]
      },
      "states": {
        "0": { "label": "Closed", "color": "green" },
        "1": { "label": "Half-Open", "color": "yellow" },
        "2": { "label": "Open", "color": "red" }
      }
    },
    {
      "id": "trace-heatmap",
      "title": "Trace Duration Heatmap",
      "type": "heatmap",
      "grid_position": { "col": 1, "row": 13, "col_span": 12, "row_span": 4 },
      "data_source": "otlp-traces",
      "query": {
        "service": "harness_recorder",
        "operation": "*",
        "bucket_count": 20,
        "time_range": "1h"
      }
    }
  ],
  "alert_thresholds": {
    "latency": {
      "p50_warning_ms": 500,
      "p50_critical_ms": 2000,
      "p95_warning_ms": 1000,
      "p95_critical_ms": 5000
    },
    "throughput": {
      "minimum_reqps": 10,
      "maximum_reqps": 1000
    },
    "errors": {
      "error_rate_warning_pct": 1.0,
      "error_rate_critical_pct": 5.0
    },
    "saturation": {
      "terminal_count_warning": 50,
      "terminal_count_critical": 100
    }
  },
  "refresh_intervals": {
    "realtime_seconds": 10,
    "default_seconds": 30,
    "overview_seconds": 60,
    "historical_seconds": 300
  },
  "multi_region": {
    "enabled": true,
    "regions": [
      {
        "id": "us-east-1",
        "name": "US East (Virginia)",
        "data_center": "iad",
        "is_primary": true,
        "replication": "sync",
        "latency_budget_ms": 50
      },
      {
        "id": "us-west-2",
        "name": "US West (Oregon)",
        "data_center": "pdx",
        "is_primary": false,
        "replication": "async",
        "latency_budget_ms": 100
      },
      {
        "id": "eu-west-1",
        "name": "EU West (Ireland)",
        "data_center": "dub",
        "is_primary": false,
        "replication": "async",
        "latency_budget_ms": 150
      },
      {
        "id": "ap-southeast-1",
        "name": "Asia Pacific (Singapore)",
        "data_center": "sgp",
        "is_primary": false,
        "replication": "async",
        "latency_budget_ms": 200
      }
    ],
    "failover": {
      "strategy": "automatic",
      "health_check_interval_seconds": 15,
      "failure_threshold": 3,
      "recovery_threshold": 2,
      "max_failover_time_seconds": 60
    },
    "routing": {
      "strategy": "latency-based",
      "fallback": "round-robin",
      "sticky_session": false,
      "geo_dns_enabled": true
    }
  },
  "time_range": {
    "default": "1h",
    "options": ["5m", "15m", "1h", "6h", "24h", "7d", "30d"]
  }
}
